POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# DSN для приложения внутри docker-compose
DATABASE_DSN=postgres://postgres:postgres@postgres:5432/postgres?sslmode=disable

# DSN для goose с хоста
DATABASE_DSN_LOCAL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable